rules_version = '2';

// Regole di base per il database Firestore del sito Ferie & Congressi.
// Consentono lettura e scrittura a chiunque abbia il link del sito, ma
// verificano che i dati abbiano il formato atteso.
service cloud.firestore {
  match /databases/{database}/documents {

    match /years/{yearId} {
      allow read: if true;
      // Gruppo di specializzandi: startYear = anno di inizio del loro I anno
      allow create, update: if request.resource.data.startYear is int
                            && (!('residents' in request.resource.data) || request.resource.data.residents is list);
      allow delete: if false;
    }

    // Un documento per specializzando e anno accademico: id = yearId__residentId__ay
    match /absences/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.yearId is string
                            && request.resource.data.residentId is string
                            && request.resource.data.ay is string
                            && request.resource.data.days is map
                            && request.resource.data.days.size() <= 400
                            && docId == request.resource.data.yearId + '__' + request.resource.data.residentId + '__' + request.resource.data.ay;
      allow delete: if true;
    }

    // Commenti del rappresentante
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if request.resource.data.yearId is string
                            && request.resource.data.ay is string
                            && request.resource.data.text is string
                            && request.resource.data.text.size() <= 500;
      allow delete: if true;
    }

    // Iscrizioni alle notifiche push: dal sito si creano e si cancellano, ma non si leggono
    // (le legge solo il programma delle notifiche, con la chiave di servizio)
    match /pushSubs/{subId} {
      allow read: if false;
      allow create, update: if request.resource.data.endpoint is string
                            && request.resource.data.endpoint.matches('https://.*')
                            && request.resource.data.endpoint.size() <= 1000
                            && request.resource.data.keys.p256dh is string
                            && request.resource.data.keys.auth is string
                            && request.resource.data.kind in ['res', 'rep']
                            && request.resource.data.yearId is string
                            && request.resource.data.residentId is string;
      allow delete: if true;
    }

    // meta/notifier (stato del programma delle notifiche) e tutto il resto: solo lato server
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
